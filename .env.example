# Copy to .env and fill credentials privately. Never expose them with NEXT_PUBLIC_.
# Existing .env values must be preserved. pnpm db:configure fills local DB values.
SABR_DB_PASSWORD=
DATABASE_URL=
APP_DATA_DIR=./.data

# Script generation through OpenRouter only. These are the only permitted LLMs:
# openai/gpt-5.6-luna (default), google/gemini-3.8-flash
OPENROUTER_API_KEY=
# Embedding model will be selected/versioned separately during source retrieval.

# Direct speech providers. Preserve the creator's ELEVEN_LABS spelling.
ELEVEN_LABS_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Speech preference is saved per episode. No paid or OpenRouter speech fallback.
# Actual balance, account rights, and voice checks will be wired to generation.

# Quran Foundation backend/server credentials. New apps begin in pre-live.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
QURAN_TRANSLATION_ID=85
# Resource 85 is the pre-live inspection edition; publication reuse is not cleared.
# Access has been requested; leave blank until the reply arrives.
SUNNAH_API_KEY=
