{
  "name": "sabr-and-steps",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:harness": "node scripts/check-harness.mjs",
    "check": "pnpm check:harness && pnpm lint && pnpm typecheck && pnpm test",
    "db:configure": "node scripts/configure-db.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:db": "tsx --conditions=react-server --test tests/integration/*.test.ts",
    "sources:list": "tsx --conditions=react-server scripts/inspect-quran.ts",
    "sources:import": "tsx --conditions=react-server scripts/import-quran.ts",
    "sources:verify": "tsx --conditions=react-server scripts/verify-quran.ts",
    "worker": "tsx --conditions=react-server worker/main.ts",
    "writing": "tsx --conditions=react-server scripts/writing.ts",
    "media:seed": "tsx --conditions=react-server scripts/seed-studio-music.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@next/env": "16.2.6",
    "@remotion/bundler": "4.0.524",
    "@remotion/gif": "4.0.524",
    "@remotion/player": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "entities": "8.1.0",
    "intl-messageformat": "10.7.16",
    "lucide-react": "1.45.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.524",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.8",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.25.1",
    "@next/eslint-plugin-next": "16.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.9.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "8.34.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.25.1",
    "eslint-config-next": "16.2.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "16.0.0",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "5.6.3"
  }
}
